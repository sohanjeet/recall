# Copy to .env at the repo root. Read by the server only; never exposed to the web bundle.

NODE_ENV=development
PORT=8787
APP_URL=http://localhost:5173

# Supabase → Project Settings → Database → Connection string (URI).
# Use the session pooler (port 5432) or direct connection; the transaction pooler (6543) also works for this app.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Set to false for a local Postgres without TLS.
DATABASE_SSL=true

# Required. Groq (OpenAI-compatible API). Key: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional: Linear task sync. Leave blank to keep approved tasks local-only.
# API key: Linear → Settings → Security & access → Personal API keys.
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# Optional: only toggles the email indicator in /api/health. No email is sent; reminders and digests are in-app only.
RESEND_API_KEY=
EMAIL_FROM=

# Required: Supabase Auth (email/password). Project Settings → API.
# SUPABASE_URL and SUPABASE_ANON_KEY (anon or publishable key) are public by design: the server hands them to the
# browser via /api/auth/config. Never put the service_role / secret key here; the server does not need it.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Only for projects still on the legacy HS256 JWT secret (Project Settings → JWT Keys). Projects using asymmetric
# signing keys are verified through the public JWKS endpoint and should leave this blank.
SUPABASE_JWT_SECRET=
# Comma-separated emails allowed to use Recall. Empty means nobody can use the API (deny by default).
AUTH_ALLOWED_EMAILS=

# Optional: extra browser origins allowed to call the API cross-origin (APP_URL is always allowed).
CORS_ORIGINS=
# Number of reverse proxies in front of the server (e.g. 1 on Render/Fly/Railway), so rate limits see real client IPs.
TRUST_PROXY=0
