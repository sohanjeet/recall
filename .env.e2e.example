# Copy to .env.e2e (gitignored). Used ONLY by the opt-in real E2E suite (pnpm e2e:real); see docs/REAL_E2E.md.
# Every value must belong to a DISPOSABLE test project, never the real workspace in .env.

NODE_ENV=development
# Dedicated, empty Supabase project: connection string, URL and anon/publishable key.
DATABASE_URL=postgresql://postgres.<test-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
SUPABASE_URL=https://<test-project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Real extraction runs against Groq. Use a key you are happy to spend a few requests on.
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-20b

# The dedicated test account (an email + password user created in the TEST Supabase project).
AUTH_ALLOWED_EMAILS=recall-e2e@example.com
RECALL_E2E_EMAIL=recall-e2e@example.com
RECALL_E2E_PASSWORD=

# Only for the Linear sync test (which also needs RECALL_E2E_LINEAR=1 and RECALL_E2E_LINEAR_CONFIRM=create-real-linear-issues
# in your shell). Leave blank otherwise: the suite then blanks Linear for the server, so approvals stay local.
# Use a dedicated test team, never the team in the real .env.
LINEAR_API_KEY=
LINEAR_TEAM_ID=
